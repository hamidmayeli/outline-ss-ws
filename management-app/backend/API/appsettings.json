{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "your-secret-key-here-change-in-production-min-32-chars",
    "Issuer": "OutlineManager",
    "Audience": "OutlineManagerAPI",
    "ExpirationMinutes": "15",
    "RefreshTokenExpirationDays": "30"
  },
  "AppSettings": {
    "Domain": "localhost",
    "TcpPath": "/tcp-ws",
    "UdpPath": "/udp-ws",
    "OutlineConfigPath": "/etc/outline/config.yaml",
    "PrometheusUrl": "http://outline-server:9092",
    "ClientLimitCheckMinutes": 15
  },
  "DataDirectory": "./data"
}
