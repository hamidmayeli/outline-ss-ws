{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "OutlineManager.API": "Trace",
      "System.Net.Http.HttpClient.IMetricsService": "Warning"
    }
  },
  "Jwt": {
    "SecretKey": "dev-secret-key-for-development-only-min-32-characters-long",
    "Issuer": "OutlineManager",
    "Audience": "OutlineManagerAPI",
    "ExpirationHours": "168"
  },
  "AppSettings": {
    "Domain": "localhost",
    "TcpPath": "/tcp-ws",
    "UdpPath": "/udp-ws",
    "OutlineConfigPath": "./outline-config/config.yaml",
    "PrometheusUrl": "http://outline-server:9092",
    "ClientLimitCheckMinutes": 15
  },
  "DataDirectory": "./data"
}
